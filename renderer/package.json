{
  "name": "kiwi-paper-renderer",
  "version": "1.0.0",
  "description": "Markdown-to-HTML renderer for kiwi-paper documents",
  "type": "module",
  "bin": {
    "kiwi-render": "./src/render.mjs"
  },
  "scripts": {
    "render": "node src/render.mjs"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "katex": "^0.19.1",
    "marked": "^18.1.2",
    "marked-footnote": "^1.4.0",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.13",
    "shiki": "^4.5.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "overrides": {
    "marked-katex-extension": {
      "katex": "$katex"
    }
  }
}
